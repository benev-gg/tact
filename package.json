{
	"name": "@benev/tact",
	"version": "0.3.0-2",
	"description": "🎮 keybindings and couch co-op",
	"license": "MIT",
	"author": "Chase Moskal <chasemoskal@gmail.com>",
	"type": "module",
	"main": "./x/index.js",
	"sideEffects": false,
	"exports": {
		".": "./x/index.js",
		"./ui": "./x/index-ui.js"
	},
	"files": [
		"x",
		"s"
	],
	"scripts": {
		"build": "octo-s 'rm -rf x' 'tsc' 'scute -v'",
		"dev": "octo 'scute -vw' 'tsc -w' 'node --watch x/test.js' 'hottie x --port=8081'",
		"test": "node x/test.js",
		"count": "find s -path '*/_archive' -prune -o -name '*.ts' -exec wc -l {} +"
	},
	"peerDependencies": {
		"@e280/sly": "^0.4.6",
		"@e280/strata": "^0.4.3",
		"lit": "^3.3.3"
	},
	"dependencies": {
		"@benev/math": "^0.4.0-2",
		"@e280/kv": "^0.2.0",
		"@e280/stz": "^0.3.10"
	},
	"devDependencies": {
		"@e280/hottie": "^0.1.5",
		"@e280/octo": "^0.1.5",
		"@e280/science": "^0.1.12",
		"@e280/scute": "^0.5.2",
		"http-server": "^14.1.1",
		"npm-run-all": "^4.1.5",
		"typescript": "^7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/benev-gg/tact.git"
	},
	"bugs": {
		"url": "https://github.com/benev-gg/tact/issues"
	},
	"homepage": "https://github.com/benev-gg/tact#readme",
	"keywords": [
		"user input",
		"keybinds",
		"keybindings",
		"gamepad"
	],
	"allowScripts": {
		"classic-level@3.0.0": true,
		"esbuild@0.28.2": true
	}
}
